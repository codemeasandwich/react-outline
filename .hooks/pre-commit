#!/bin/bash

# Set up PATH to find Node.js tools (nvm, Volta, Homebrew)
export PATH="$HOME/.nvm/versions/node/$(ls -t $HOME/.nvm/versions/node 2>/dev/null | head -1)/bin:$PATH"
export PATH="$HOME/.volta/bin:$PATH"
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Rebuild the bundle using esbuild
echo "Rebuilding dist/reactOutline.js..."
npx esbuild source/main.js --bundle --minify --sourcemap --outfile=dist/reactOutline.js --format=cjs --platform=node --loader:.js=jsx

# Check if the build was successful
if [ $? -ne 0 ]; then
  echo "Error: Bundle build failed!"
  exit 1
fi

# Auto-stage changed files if rebuild produced changes
if git diff --name-only | grep -E '\.js(\.map)?$' | grep -q '^dist/'; then
  echo "Auto-staging updated bundle files..."
  git add dist/reactOutline.js dist/reactOutline.js.map 2>/dev/null
fi

echo "Pre-commit hook completed successfully."
